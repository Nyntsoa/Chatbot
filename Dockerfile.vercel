FROM ollama/ollama:0.40.18 AS models

ENV OLLAMA_MODELS=/opt/guidebot-models OLLAMA_HOST=127.0.0.1:11434 OLLAMA_NO_CLOUD=1
RUN set -eu; ollama serve >/tmp/ollama.log 2>&1 & server=$!; \
    trap 'kill "$server" 2>/dev/null || true' EXIT; \
    for attempt in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 1; done; \
    ollama pull llama3.2:1b-instruct-q4_K_M; \
    ollama pull embeddinggemma; \
    mkdir /tmp/ollama-cpu; \
    find /usr/lib/ollama -maxdepth 1 \( -type f -o -type l \) -exec cp -a '{}' /tmp/ollama-cpu/ \;

FROM python:3.13-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 GUIDEBOT_WEB_SETUP=0 \
    GUIDEBOT_REQUIRE_REMOTE_DB=1 GUIDEBOT_ANSWER_MODEL=llama3.2:1b-instruct-q4_K_M \
    OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MODELS=/opt/guidebot-models OLLAMA_NO_CLOUD=1 \
    OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_NUM_PARALLEL=1 HOME=/tmp

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libopenblas0-pthread \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY .streamlit/config.toml ./.streamlit/config.toml
COPY app/ ./app/
COPY docs/ ./docs/
COPY images/ ./images/
COPY prompts/ ./prompts/
COPY --from=models /usr/bin/ollama /usr/bin/ollama
COPY --from=models /tmp/ollama-cpu/ /usr/lib/ollama/
COPY --from=models /opt/guidebot-models/ /opt/guidebot-models/

EXPOSE 3000
CMD ["sh", "-c", "ollama serve & exec python -m streamlit run app/main.py --server.address=0.0.0.0 --server.port=${PORT:-3000} --server.runOnSave=false --server.fileWatcherType=none"]
